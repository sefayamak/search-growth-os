{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "search-growth-os/agent-schema-entity",
  "title": "Ajan schema/entity önerisi. JSON-LD yalnız TASLAK alanında saklanır; uygulanmaz (mutation: none).",
  "description": "Cross-site, uydurma-olgu ve sameAs denetimleri src/agent-contracts.ts validateSchemaEntity() içinde; JSON Schema bunları ifade edemez.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "kind", "site", "source_url", "target_url_or_entity", "reason", "evidence", "confidence", "risk", "expected_change", "approval_state", "mutation", "schema_type", "jsonld_draft", "fact_sources"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "kind": { "const": "schema_entity" },
    "site": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "source_url": { "type": "string", "format": "uri", "description": "Schema'nın ekleneceği sayfa." },
    "target_url_or_entity": { "type": "string", "minLength": 1, "description": "Entity adı, @id ya da URL." },
    "reason": { "type": "string", "minLength": 1 },
    "evidence": {
      "type": "object", "additionalProperties": false, "required": ["refs", "label"],
      "properties": {
        "refs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "label": { "enum": ["FACT", "INFERENCE", "HYPOTHESIS", "RECOMMENDATION"] }
      }
    },
    "confidence": { "enum": ["CONFIRMED", "CANDIDATE", "FALSE_POSITIVE", "UNKNOWN"] },
    "risk": { "enum": ["low", "medium", "high"] },
    "expected_change": {
      "type": "object", "additionalProperties": false, "required": ["hypothesis", "test"],
      "properties": { "hypothesis": { "type": "string", "minLength": 1 }, "test": { "type": "string", "minLength": 1 } }
    },
    "approval_state": { "enum": ["PROPOSED", "REVIEW_REQUIRED", "OWNER_APPROVED", "REJECTED"] },
    "approver": { "type": "string", "minLength": 1 },
    "mutation": { "const": "none" },
    "schema_type": { "enum": ["Organization", "LocalBusiness", "Person", "WebSite", "WebPage", "AboutPage", "ContactPage", "ProfilePage", "Article", "BlogPosting", "BreadcrumbList", "FAQPage", "Service", "ImageObject"] },
    "jsonld_draft": { "type": ["string", "object"], "description": "Çıplak JSON-LD (script etiketi yok). Yalnız taslak." },
    "fact_sources": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["property", "source_url", "label"],
        "properties": {
          "property": { "type": "string", "minLength": 1 },
          "source_url": { "type": "string", "format": "uri", "description": "Olgunun görünür olduğu, sitenin KENDİ sayfası." },
          "label": { "const": "FACT" }
        }
      }
    }
  },
  "allOf": [
    { "if": { "properties": { "approval_state": { "const": "OWNER_APPROVED" } }, "required": ["approval_state"] }, "then": { "required": ["approver"] }, "else": { "not": { "required": ["approver"] } } }
  ]
}
