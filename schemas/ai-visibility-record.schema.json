{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "search-growth-os/ai-visibility-record",
  "title": "One observation of one prompt on one AI system. Stochastic: never a single run per cell.",
  "type": "object",
  "required": ["site_id", "prompt_id", "prompt", "prompt_variant", "platform", "model", "observed_at", "market", "language", "topic", "funnel_stage", "intent", "brand_or_nonbrand", "response_text", "brand_mentioned", "brand_cited", "cited_urls", "competitor_mentions", "citation_sources", "method"],
  "properties": {
    "site_id": { "type": "string" },
    "prompt_id": { "type": "string", "description": "Stable id of the prompt in the curated set." },
    "prompt": { "type": "string" },
    "prompt_variant": { "type": "string", "description": "Paraphrase id; the same intent asked differently." },
    "platform": { "type": "string", "examples": ["google_ai_overview", "google_ai_mode", "chatgpt_search", "perplexity", "bing_copilot", "gemini", "claude"] },
    "model": { "type": "string" },
    "observed_at": { "type": "string", "format": "date-time" },
    "market": { "type": "string" },
    "language": { "type": "string" },
    "topic": { "type": "string" },
    "funnel_stage": { "enum": ["awareness", "consideration", "decision"] },
    "persona": { "type": "string" },
    "intent": { "enum": ["informational", "comparison", "recommendation", "buying", "navigational"] },
    "brand_or_nonbrand": { "enum": ["brand", "nonbrand"] },
    "response_text": { "type": "string" },
    "brand_mentioned": { "type": "boolean" },
    "brand_cited": { "type": "boolean" },
    "cited_urls": { "type": "array", "items": { "type": "string" } },
    "owned_cited_urls": { "type": "array", "items": { "type": "string" } },
    "competitor_mentions": { "type": "array", "items": { "type": "string" } },
    "competitor_citations": { "type": "array", "items": { "type": "string" } },
    "citation_sources": { "type": "array", "items": { "type": "string" }, "description": "Hostnames cited, owned or not." },
    "position_context": { "type": "string", "description": "Where/how the brand appears (first recommendation, list item 4, footnote...)." },
    "referral_evidence": { "anyOf": [{ "type": "object" }, { "const": "NOT_CONNECTED" }] },
    "method": { "type": "string", "description": "How the observation was obtained (official API, licensed provider, manual). Never prohibited scraping." },
    "provider": { "type": "string", "description": "Third-party provider name when applicable." },
    "cost_estimate": { "type": "number" }
  }
}
