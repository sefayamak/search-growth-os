{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "search-growth-os/brain-evidence",
  "title": "Normalized evidence envelope (one record, ONE site). evidence_label is exactly the six labels; EDITORIAL is not one. Records of another site are rejected, never carried over.",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "evidence_id",
        "site_id",
        "source",
        "source_ref",
        "measured_at",
        "measurement_state",
        "evidence_label",
        "confidence",
        "category",
        "payload"
      ],
      "properties": {
        "schema": {
          "const": "sgos.brain.evidence.v1"
        },
        "evidence_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,95}$"
        },
        "site_id": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "enum": [
            "GSC",
            "GA4",
            "CLARITY",
            "CRAWL",
            "INDEX",
            "REGISTRY",
            "AI_VISIBILITY",
            "COMPETITOR"
          ]
        },
        "source_ref": {
          "type": "string",
          "minLength": 1
        },
        "measured_at": {
          "type": "string",
          "format": "date-time"
        },
        "measurement_state": {
          "type": "string",
          "enum": [
            "MEASURED",
            "PARTIAL",
            "RECORDED",
            "ERROR",
            "NOT_CONNECTED",
            "NOT_AVAILABLE",
            "UNKNOWN"
          ]
        },
        "evidence_label": {
          "type": "string",
          "enum": [
            "FACT",
            "INFERENCE",
            "HYPOTHESIS",
            "RECOMMENDATION",
            "IMPLEMENTED_CHANGE",
            "VERIFIED_RESULT"
          ]
        },
        "confidence": {
          "type": "string",
          "enum": [
            "CONFIRMED",
            "CANDIDATE",
            "FALSE_POSITIVE",
            "UNKNOWN"
          ]
        },
        "category": {
          "type": "string",
          "enum": [
            "SEARCH_PERFORMANCE",
            "CONTENT_OPPORTUNITY",
            "BEHAVIOR",
            "TECHNICAL",
            "INDEXING",
            "STRUCTURED_DATA",
            "AI_VISIBILITY",
            "COMPETITOR",
            "REGISTRY"
          ]
        },
        "payload": {
          "type": "object"
        },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "handoff",
            "source_workflow",
            "source_run_id",
            "source_run_attempt",
            "source_head_sha",
            "source_artifact_name",
            "source_artifact_id",
            "source_artifact_digest",
            "source_measured_at",
            "handoff_run_id"
          ],
          "description": "Optional, additive. Only strictly validated ids/timestamps of the source workflow run and artifact; never free text from GitHub.",
          "properties": {
            "handoff": {
              "const": "sgos.brain.handoff.v1"
            },
            "source_workflow": {
              "const": ".github/workflows/clarity.yml"
            },
            "source_run_id": {
              "type": "string",
              "pattern": "^\\d{1,20}$"
            },
            "source_run_attempt": {
              "oneOf": [
                {
                  "type": "integer",
                  "minimum": 1
                },
                {
                  "const": "UNKNOWN"
                }
              ]
            },
            "source_head_sha": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "source_artifact_name": {
              "type": "string",
              "pattern": "^clarity-\\d{1,20}$"
            },
            "source_artifact_id": {
              "type": "string",
              "pattern": "^\\d{1,20}$"
            },
            "source_artifact_digest": {
              "oneOf": [
                {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                },
                {
                  "const": "UNKNOWN"
                }
              ]
            },
            "source_measured_at": {
              "type": "string",
              "format": "date-time"
            },
            "handoff_run_id": {
              "oneOf": [
                {
                  "type": "string",
                  "pattern": "^\\d{1,20}$"
                },
                {
                  "const": "UNKNOWN"
                }
              ]
            }
          }
        }
      }
    },
    {
      "type": "object",
      "required": [
        "schema",
        "site_id",
        "evidence"
      ],
      "properties": {
        "schema": {
          "const": "sgos.brain.evidence-bundle.v1"
        },
        "site_id": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "maxItems": 40,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "schema",
              "evidence_id",
              "site_id",
              "source",
              "source_ref",
              "measured_at",
              "measurement_state",
              "evidence_label",
              "confidence",
              "category",
              "payload"
            ],
            "properties": {
              "schema": {
                "const": "sgos.brain.evidence.v1"
              },
              "evidence_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,95}$"
              },
              "site_id": {
                "type": "string",
                "minLength": 1
              },
              "source": {
                "type": "string",
                "enum": [
                  "GSC",
                  "GA4",
                  "CLARITY",
                  "CRAWL",
                  "INDEX",
                  "REGISTRY",
                  "AI_VISIBILITY",
                  "COMPETITOR"
                ]
              },
              "source_ref": {
                "type": "string",
                "minLength": 1
              },
              "measured_at": {
                "type": "string",
                "format": "date-time"
              },
              "measurement_state": {
                "type": "string",
                "enum": [
                  "MEASURED",
                  "PARTIAL",
                  "RECORDED",
                  "ERROR",
                  "NOT_CONNECTED",
                  "NOT_AVAILABLE",
                  "UNKNOWN"
                ]
              },
              "evidence_label": {
                "type": "string",
                "enum": [
                  "FACT",
                  "INFERENCE",
                  "HYPOTHESIS",
                  "RECOMMENDATION",
                  "IMPLEMENTED_CHANGE",
                  "VERIFIED_RESULT"
                ]
              },
              "confidence": {
                "type": "string",
                "enum": [
                  "CONFIRMED",
                  "CANDIDATE",
                  "FALSE_POSITIVE",
                  "UNKNOWN"
                ]
              },
              "category": {
                "type": "string",
                "enum": [
                  "SEARCH_PERFORMANCE",
                  "CONTENT_OPPORTUNITY",
                  "BEHAVIOR",
                  "TECHNICAL",
                  "INDEXING",
                  "STRUCTURED_DATA",
                  "AI_VISIBILITY",
                  "COMPETITOR",
                  "REGISTRY"
                ]
              },
              "payload": {
                "type": "object"
              },
              "provenance": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "handoff",
                  "source_workflow",
                  "source_run_id",
                  "source_run_attempt",
                  "source_head_sha",
                  "source_artifact_name",
                  "source_artifact_id",
                  "source_artifact_digest",
                  "source_measured_at",
                  "handoff_run_id"
                ],
                "description": "Optional, additive. Only strictly validated ids/timestamps of the source workflow run and artifact; never free text from GitHub.",
                "properties": {
                  "handoff": {
                    "const": "sgos.brain.handoff.v1"
                  },
                  "source_workflow": {
                    "const": ".github/workflows/clarity.yml"
                  },
                  "source_run_id": {
                    "type": "string",
                    "pattern": "^\\d{1,20}$"
                  },
                  "source_run_attempt": {
                    "oneOf": [
                      {
                        "type": "integer",
                        "minimum": 1
                      },
                      {
                        "const": "UNKNOWN"
                      }
                    ]
                  },
                  "source_head_sha": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{40}$"
                  },
                  "source_artifact_name": {
                    "type": "string",
                    "pattern": "^clarity-\\d{1,20}$"
                  },
                  "source_artifact_id": {
                    "type": "string",
                    "pattern": "^\\d{1,20}$"
                  },
                  "source_artifact_digest": {
                    "oneOf": [
                      {
                        "type": "string",
                        "pattern": "^sha256:[0-9a-f]{64}$"
                      },
                      {
                        "const": "UNKNOWN"
                      }
                    ]
                  },
                  "source_measured_at": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "handoff_run_id": {
                    "oneOf": [
                      {
                        "type": "string",
                        "pattern": "^\\d{1,20}$"
                      },
                      {
                        "const": "UNKNOWN"
                      }
                    ]
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}
