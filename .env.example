# Search Growth OS — integration credentials (names only, never commit values)
# Every integration is optional. Missing → adapter reports NOT_CONNECTED, never invents data.

# Google Search Console (service account JSON path or inline JSON). Scope: webmasters.readonly
SEARCH_GROWTH_GSC_CREDENTIALS_JSON=
# GA4 Data API (service account). Scope: analytics.readonly
SEARCH_GROWTH_GA4_CREDENTIALS_JSON=
# Bing Webmaster Tools API key
SEARCH_GROWTH_BING_API_KEY=
# IndexNow key (also must be hosted as https://<host>/<key>.txt). Submission is NOT done automatically in Phase 1.
SEARCH_GROWTH_INDEXNOW_KEY=
# CDN / server log source (e.g. a Vercel log drain, S3 prefix, or local path)
SEARCH_GROWTH_LOG_SOURCE=
# GitHub token for reading deploy/commit history (contents:read only)
SEARCH_GROWTH_GITHUB_TOKEN=
# Optional licensed third-party SEO data provider (labelled by provider + date in every report)
SEARCH_GROWTH_THIRD_PARTY_PROVIDER=
SEARCH_GROWTH_THIRD_PARTY_API_KEY=

# Crawler identity. Always identify honestly; never impersonate Googlebot/Bingbot/OAI-SearchBot.
SEARCH_GROWTH_USER_AGENT="SearchGrowthOS/0.1 (+https://pamistanbul.com; read-only site audit)"
