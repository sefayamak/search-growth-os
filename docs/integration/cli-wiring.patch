+  assert.equal(strict.status, 1);
+  assert.match(strict.stdout, /BLOCK_KILL_SWITCH/);
+  const ok = cli("change-eval", p("content"), "--kill-switch", ks, "--allow-absent-kill-switch");
+  assert.equal(ok.status, 0, ok.stdout + ok.stderr);
+  assert.match(ok.stdout, /ALLOW_FOR_REVIEW/);
+  assert.match(ok.stdout, /uygulama izni degildir/);
+  const robots = cli("change-eval", p("robots"), "--kill-switch", ks, "--allow-absent-kill-switch");
