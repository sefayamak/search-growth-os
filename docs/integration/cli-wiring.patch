+test("change-eval: kill-switch dosyasi yoksa (strict) engellenir; bayrakla icerik onerisi yalniz INCELEMEYE gider; robots hep insan", () => {
+  const d = tmp();
+  const rb = { method: "git_revert", revert_ref: "commit abc1234", verification_probe: "durum kodu ve canonical ayni" };
+  const p = (cls: string) => put(d, `${cls}.json`, { id: "p1", site_id: "pamistanbul", change_class: cls, targets: ["https://pamistanbul.com/a"], proposed_by: "claude-session", evidence_label: "RECOMMENDATION", confidence: "CANDIDATE", rollback: rb });
+  const ks = join(d, "yok.json");
